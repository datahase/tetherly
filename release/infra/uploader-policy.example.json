{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckReleaseBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketVersioning",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::tetherly-release"
    },
    {
      "Sid": "UploadAndVerifyReleases",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::tetherly-release/releases/*"
    }
  ]
}
