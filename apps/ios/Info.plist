<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tetherly finds and connects to your Mac on your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tetherly._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Tetherly uses the camera to scan the pairing code shown by your Mac.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>link.tetherly.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tetherly</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
