// Code signing for the Mac host. The defaults below build ad hoc, so anyone can build without an Apple account.
// To sign with your own team (so macOS keeps Screen Recording / Accessibility grants across rebuilds), copy
// Signing.local.xcconfig.example to Signing.local.xcconfig and fill it in. That file is git-ignored.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
